# Copy this file to .env and fill in your values

# Database
# SQLite (default, legacy):   sqlite:///./talentai.db
# Postgres + pgvector (new):  postgresql+psycopg2://talentai:talentai@localhost:5432/talentai
# Matches credentials in docker-compose.yml at the repo root.
DATABASE_URL=postgresql+psycopg2://talentai:talentai@localhost:5432/talentai

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Ranking funnel task queue (Celery + Redis)
# USE_CELERY=true dispatches the funnel to a Celery worker (run one with:
#   celery -A celery_app.celery_app worker --loglevel=info --pool=solo )
# Leave false for local dev — the funnel then runs in an in-process thread.
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# Screening Config
MAX_APPLICATIONS_PER_JOB=10
MIN_MATCH_SCORE=80.0

# Email (optional — if not set, emails are logged to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aniketshrivastav02@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=aniketshrivastav02@gmail.com

# App
FRONTEND_URL=http://localhost:5173

# LinkedIn OAuth (Sign In with LinkedIn v2 — OpenID Connect)
# Register your app at https://www.linkedin.com/developers/apps
# Add redirect URI: http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# Google OAuth (Sign in with Google — OpenID Connect)
# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# AWS S3 — resume original file storage (optional)
# Leave blank to fall back to text-only resume display.
# IAM user needs: s3:PutObject, s3:GetObject on the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PRESIGN_EXPIRY=900
